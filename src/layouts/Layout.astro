---
import '../styles/global.css';
const {title='AI 产品调研库',description='樊同学的 AI 产品研究与观察',wide=false} = Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title} · 樊同学</title><link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}/></head>
<body><a class="skip" href="#main">跳到正文</a><header><a class="brand" href={`${base}/`}><svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><rect width="34" height="34" rx="9" fill="#173c70"/><path d="M9 24V10h7a5 5 0 010 10H9m10-1 6 5" fill="none" stroke="white" stroke-width="2.5"/></svg><span>AI 产品调研库<small>樊同学的产品观察</small></span></a><nav aria-label="主导航"><a href={`${base}/`}>调研档案</a><a href={`${base}/install/`}>安装 Skill</a><a class="quiet" href={`${base}/legacy/`}>在线调研工具</a><a class="quiet" href="https://github.com/askfanxiaojun/AI-Product-Research">GitHub</a></nav></header>
<main id="main" class:list={[{wide}]}><slot/></main><footer><span>从一次调研，到持续理解。</span><a href="https://github.com/askfanxiaojun/AI-Product-Research/tree/main/content/products">查看原始报告</a></footer></body></html>
