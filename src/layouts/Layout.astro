---
import '../styles/global.css';
const {title='AI 产品调研库',description='樊同学的 AI 产品研究与观察',wide=false} = Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title} · 樊同学</title><link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`}/><link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`}/><link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`}/><link rel="manifest" href={`${base}/site.webmanifest`}/><meta name="theme-color" content="#173c70"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(`${base}/brand/research-icon-512.png`, Astro.site).href}/><meta name="twitter:card" content="summary"/></head>
<body><a class="skip" href="#main">跳到正文</a><header><a class="brand" href={`${base}/`}><img class="brand-icon" src={`${base}/brand/research-icon-192.png`} width="38" height="38" alt="" decoding="async"/><span>AI 产品调研库<small>樊同学的产品观察</small></span></a><nav aria-label="主导航"><a href={`${base}/`}>调研档案</a><a href={`${base}/install/`}>安装 Skill</a><a class="quiet" href={`${base}/legacy/`}>在线调研工具</a><a class="quiet" href="https://github.com/askfanxiaojun/AI-Product-Research">GitHub</a></nav></header>
<main id="main" class:list={[{wide}]}><slot/></main><footer><span class="footer-brand"><img src={`${base}/brand/research-icon-192.png`} width="22" height="22" alt="" loading="lazy"/>从一次调研，到持续理解。</span><a href="https://github.com/askfanxiaojun/AI-Product-Research/tree/main/content/products">查看原始报告</a></footer></body></html>
